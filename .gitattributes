# Plan fixtures and sample plans are read byte for byte, as an agent writes them, so
# they keep LF line endings on every platform.
libraries/viewers/src/markdown/fixtures/*.md text eol=lf
frontend/demo/src/showcase/plans/*.md text eol=lf
# whisper.cpp patches apply to its LF sources, so they keep LF on every platform.
engines/whisper/patches/*.patch text eol=lf
# The same for llama.cpp's.
engines/murmur/patches/*.patch text eol=lf
# The known-flake register's fixtures are CI logs its matcher reads line by line.
scripts/flakes/fixtures/*.txt text eol=lf
# Schema snapshots the store's tests rewrite line by line keep LF on every platform.
backend/runner/src/workspaces/schemas/*.sql text eol=lf
# The workflows' tests (scripts/quality/plan, scripts/e2e/plan) find jobs and steps in them by
# their lines, and run the gates' bash out of them, on Windows too.
.github/workflows/*.yml text eol=lf
# The viewer frame's page (PDFs and 3D models) allows its one script by a hash of its text, which
# the browser reads with LF line endings; the tests hash it as checked out, so it keeps LF on every
# platform.
libraries/viewers/src/frame/frame.html text eol=lf
frontend/ui/public/viewer-frame.html text eol=lf
