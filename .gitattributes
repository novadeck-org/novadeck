# Plan fixtures and sample plans are read byte for byte, as an agent writes them, so
# they keep LF line endings on every platform.
libraries/viewers/src/markdown/fixtures/*.md text eol=lf
frontend/demo/src/showcase/plans/*.md text eol=lf
# whisper.cpp patches apply to its LF sources, so they keep LF on every platform.
engines/whisper/patches/*.patch text eol=lf
# The same for llama.cpp's.
engines/murmur/patches/*.patch text eol=lf
# The known-flake register's fixtures are CI logs its matcher reads line by line.
scripts/flakes/fixtures/*.txt text eol=lf
