{
  "name": "novadeck",
  "version": "0.0.0",
  "private": true,
  "description": "A cross-platform desktop application.",
  "homepage": "https://github.com/novadeck-org/novadeck",
  "author": "mzpkdev",
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @novadeck/host dev",
    "dev:web": "node scripts/dev-web/main.ts",
    "dev:previews": "pnpm --filter @novadeck/protocol build && pnpm --filter @novadeck/ui dev --mode content-preview --port 5181",
    "atlas": "pnpm --filter @novadeck/protocol build && pnpm --filter @novadeck/atlas dev",
    "atlas:brief": "node atlas/brief/main.ts",
    "dev:try": "pnpm --filter @novadeck/protocol build && pnpm --filter @novadeck/ui dev --mode try --port 5190",
    "build:try": "pnpm --filter @novadeck/protocol build && pnpm --filter @novadeck/ui build --mode try --outDir dist-try",
    "preview:try": "pnpm --filter @novadeck/ui preview --outDir dist-try --port 5191 --strictPort",
    "poster:try": "pnpm --filter @novadeck/ui poster:try",
    "build": "turbo run build",
    "bench:timing": "turbo run build --filter=@novadeck/runner --filter=@novadeck/sandbox && node scripts/bench/timing/main.ts",
    "new:library": "node scripts/libraries/new.ts",
    "preview": "pnpm --filter @novadeck/runner start",
    "package": "pnpm --filter @novadeck/host package",
    "package:linux": "pnpm --filter @novadeck/host package:linux",
    "package:mac": "pnpm --filter @novadeck/host package:mac",
    "package:win": "pnpm --filter @novadeck/host package:win",
    "test": "pnpm run test:repository && turbo run test --concurrency=1",
    "test:repository": "vitest run --config vitest.config.ts",
    "test:e2e": "pnpm --filter @novadeck/protocol --filter @novadeck/relay build && pnpm --filter @novadeck/runner test:e2e",
    "test:e2e:install": "pnpm --filter @novadeck/protocol --filter @novadeck/relay build && node scripts/e2e/install/main.ts",
    "test:e2e:isolated": "pnpm test:e2e:install && node scripts/e2e/isolated/main.ts -- pnpm --filter @novadeck/runner test:e2e",
    "typecheck": "tsc --noEmit -p tsconfig.json && turbo run typecheck",
    "lint": "oxlint --deny-warnings . && pnpm --filter @novadeck/relay lint",
    "format": "oxfmt && pnpm --filter @novadeck/relay format",
    "format:check": "oxfmt --check && pnpm --filter @novadeck/relay format:check"
  },
  "devDependencies": {
    "@novadeck/sandbox": "workspace:*",
    "@release-it/conventional-changelog": "12.0.2",
    "@types/node": "^26.6.5",
    "concurrently": "^10.0.6",
    "conventional-changelog-conventionalcommits": "10.4.1",
    "esbuild": "0.28.2",
    "msw": "^2.15.0",
    "oxfmt": "^0.72.0",
    "oxlint": "^1.87.0",
    "playwright": "^1.64.0",
    "release-it": "21.1.1",
    "turbo": "^2.11.7",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": "26.x"
  },
  "packageManager": "pnpm@11.22.0"
}
