{
  "name": "@novadeck/protocol",
  "version": "0.0.0",
  "private": true,
  "description": "Shared Novadeck runner contracts and client.",
  "type": "module",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./client": {
      "development": "./src/client.ts",
      "types": "./dist/client.d.ts",
      "default": "./dist/client.js"
    },
    "./bridge": {
      "development": "./src/bridge.ts",
      "types": "./dist/bridge.d.ts",
      "default": "./dist/bridge.js"
    },
    "./harnesses": {
      "development": "./src/harnesses.ts",
      "types": "./dist/harnesses.d.ts",
      "default": "./dist/harnesses.js"
    },
    "./pages": {
      "development": "./src/pages.ts",
      "types": "./dist/pages.d.ts",
      "default": "./dist/pages.js"
    },
    "./text": {
      "development": "./src/text.ts",
      "types": "./dist/text.d.ts",
      "default": "./dist/text.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@novadeck/terminal": "workspace:*",
    "@novadeck/wire": "workspace:*",
    "@orpc/contract": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "typescript": "^7.0.2"
  }
}
