{
  "name": "@novadeck/runner",
  "version": "0.0.0",
  "private": true,
  "description": "The NovaDeck runner: shells and workspace metadata, served over WebSocket or MessagePort.",
  "author": "mzpkdev",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/cli.js",
  "exports": {
    ".": "./src/index.ts",
    "./server": "./src/server.ts",
    "./http": "./src/http.ts",
    "./app": "./src/app.ts"
  },
  "scripts": {
    "dev": "tsx watch src/cli.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/cli.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "@novadeck/protocol": "workspace:*",
    "@orpc/server": "1.15.4",
    "@xterm/addon-serialize": "0.14.0",
    "@xterm/headless": "6.0.0",
    "hono": "^4.13.8",
    "node-pty": "1.2.0-beta.14",
    "ws": "8.21.3"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "@types/ws": "8.18.1",
    "fast-check": "4.10.2",
    "tsx": "^4.20.6",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  }
}
