HOST=127.0.0.1
PORT=8787
CORS_ORIGINS=http://127.0.0.1:5173

# Terminal RPC stays disabled until a random token is configured (32–512 characters).
# Generate one with: node -e 'console.log(require("node:crypto").randomBytes(32).toString("hex"))'
# NOVADECK_TOKEN=replace-with-your-generated-token
# Default metadata path: ~/.local/share/novadeck/workspace.sqlite
# NOVADECK_DATABASE=/absolute/path/to/workspace.sqlite
