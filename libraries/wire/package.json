{
  "name": "@novadeck/wire",
  "version": "0.0.0",
  "private": true,
  "description": "RPC calls and streams between processes over a WebSocket or a MessagePort: channels, a client generic over its contract, its transports, a connection that keeps itself alive and the streams it follows, the server's streams of state, and its errors.",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./client": {
      "development": "./src/client.ts",
      "types": "./dist/client.d.ts",
      "default": "./dist/client.js"
    },
    "./testing": {
      "development": "./src/testing.ts",
      "types": "./dist/testing.d.ts",
      "default": "./dist/testing.js"
    },
    "./server": {
      "node": {
        "development": "./src/server.ts",
        "types": "./dist/server.d.ts",
        "default": "./dist/server.js"
      }
    },
    "./electron": {
      "node": {
        "development": "./src/electron.ts",
        "types": "./dist/electron.d.ts",
        "default": "./dist/electron.js"
      }
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@orpc/client": "catalog:",
    "@orpc/contract": "catalog:",
    "@orpc/standard-server-peer": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@orpc/server": "catalog:",
    "@types/node": "^26.6.5",
    "@types/ws": "8.18.2",
    "electron": "catalog:",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5",
    "ws": "catalog:"
  },
  "peerDependencies": {
    "@orpc/server": "catalog:",
    "electron": "catalog:",
    "ws": "catalog:"
  },
  "peerDependenciesMeta": {
    "@orpc/server": {
      "optional": true
    },
    "electron": {
      "optional": true
    },
    "ws": {
      "optional": true
    }
  }
}
