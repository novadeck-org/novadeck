{
  "name": "@novadeck/terminal",
  "version": "0.0.0",
  "private": true,
  "description": "Hosting terminals and attaching to them: a pty, a headless screen kept in step with it, a resumable stream of it, its browser view, and shell integration.",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./host": {
      "node": {
        "development": "./src/host.ts",
        "types": "./dist/host.d.ts",
        "default": "./dist/host.js"
      }
    },
    "./pty": {
      "node": {
        "development": "./src/pty.ts",
        "types": "./dist/pty.d.ts",
        "default": "./dist/pty.js"
      }
    },
    "./shell": {
      "node": {
        "development": "./src/shell.ts",
        "types": "./dist/shell.d.ts",
        "default": "./dist/shell.js"
      }
    },
    "./testing": {
      "node": {
        "development": "./src/testing.ts",
        "types": "./dist/testing.d.ts",
        "default": "./dist/testing.js"
      }
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node --input-type=module -e \"import { cpSync } from 'node:fs'; cpSync('src/testing/child.mjs', 'dist/testing/child.mjs')\"",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "fast-check": "4.10.2",
    "node-pty": "catalog:",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "peerDependencies": {
    "node-pty": "catalog:"
  },
  "peerDependenciesMeta": {
    "node-pty": {
      "optional": true
    }
  }
}
