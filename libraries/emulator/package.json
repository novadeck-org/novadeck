{
  "name": "@novadeck/emulator",
  "version": "0.0.0",
  "private": true,
  "description": "The terminal emulator: xterm.js and its addons pinned and patched in one place, the character-width rule every emulator shares, and helpers that need only an emulator.",
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./width": {
      "development": "./src/width.ts",
      "types": "./dist/width.d.ts",
      "default": "./dist/width.js"
    },
    "./browser": {
      "development": "./src/browser.ts",
      "types": "./dist/browser.d.ts",
      "default": "./dist/browser.js"
    },
    "./browser.css": "./src/browser.css",
    "./headless": {
      "node": {
        "development": "./src/headless.ts",
        "types": "./dist/headless.d.ts",
        "default": "./dist/headless.js"
      }
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "ligature-table": "node src/ligature-table.generate.ts && pnpm -w exec oxfmt libraries/emulator/src/ligature-table.ts"
  },
  "dependencies": {
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-serialize": "0.14.0",
    "@xterm/addon-unicode-graphemes": "0.4.0",
    "@xterm/addon-web-links": "0.12.0",
    "@xterm/addon-webgl": "0.19.0",
    "@xterm/headless": "6.0.0",
    "@xterm/xterm": "6.0.0"
  },
  "devDependencies": {
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@types/node": "^26.6.5",
    "font-ligatures": "1.4.1",
    "jsdom": "^30.1.3",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
