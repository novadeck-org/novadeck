{
  "name": "@novadeck/viewers",
  "version": "0.0.0",
  "private": true,
  "description": "Content viewers behind one contract: code, changes, image, markdown and web pages, each mounted into an element, keeping its scroll and place across remounts through state its app stores.",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./code": {
      "development": "./src/code.ts",
      "types": "./dist/code.d.ts",
      "default": "./dist/code.js"
    },
    "./code.css": "./src/code.css",
    "./diff": {
      "development": "./src/diff.ts",
      "types": "./dist/diff.d.ts",
      "default": "./dist/diff.js"
    },
    "./diff.css": "./src/diff.css",
    "./image": {
      "development": "./src/image.ts",
      "types": "./dist/image.d.ts",
      "default": "./dist/image.js"
    },
    "./image.css": "./src/image.css",
    "./markdown": {
      "development": "./src/markdown.ts",
      "types": "./dist/markdown.d.ts",
      "default": "./dist/markdown.js"
    },
    "./markdown.css": "./src/markdown.css",
    "./markdown-blocks": {
      "development": "./src/markdown-blocks.ts",
      "types": "./dist/markdown-blocks.d.ts",
      "default": "./dist/markdown-blocks.js"
    },
    "./sync": {
      "development": "./src/sync.ts",
      "types": "./dist/sync.d.ts",
      "default": "./dist/sync.js"
    },
    "./text": {
      "development": "./src/text.ts",
      "types": "./dist/text.d.ts",
      "default": "./dist/text.js"
    },
    "./browser": {
      "development": "./src/browser.ts",
      "types": "./dist/browser.d.ts",
      "default": "./dist/browser.js"
    },
    "./browser/trouble": {
      "development": "./src/browser/trouble.ts",
      "types": "./dist/browser/trouble.d.ts",
      "default": "./dist/browser/trouble.js"
    },
    "./browser/sign-in": {
      "development": "./src/browser/sign-in.ts",
      "types": "./dist/browser/sign-in.d.ts",
      "default": "./dist/browser/sign-in.js"
    },
    "./browser.css": "./src/browser.css",
    "./browser/host": {
      "node": {
        "development": "./src/browser/host.ts",
        "types": "./dist/browser/host.d.ts",
        "default": "./dist/browser/host.js"
      }
    },
    "./react": {
      "development": "./src/react.ts",
      "types": "./dist/react.d.ts",
      "default": "./dist/react.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/language": "^6.13.1",
    "@lezer/common": "^1.5.3",
    "@lezer/cpp": "^1.1.6",
    "@lezer/css": "^1.3.9",
    "@lezer/go": "^1.0.1",
    "@lezer/highlight": "^1.2.5",
    "@lezer/html": "^1.3.13",
    "@lezer/java": "^1.1.5",
    "@lezer/javascript": "^1.5.6",
    "@lezer/json": "^1.0.3",
    "@lezer/markdown": "^1.8.0",
    "@lezer/python": "^1.1.19",
    "@lezer/rust": "^1.0.3",
    "@lezer/xml": "^1.0.6",
    "@lezer/yaml": "^1.0.4"
  },
  "devDependencies": {
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.14",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/browser-playwright": "5.0.5",
    "electron": "catalog:",
    "playwright": "^1.64.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "peerDependencies": {
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.14",
    "electron": "catalog:",
    "react": "^19.3.1"
  },
  "peerDependenciesMeta": {
    "electron": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  }
}
