{
  "name": "@novadeck/desktop",
  "version": "0.0.0",
  "private": true,
  "description": "A workspace for parallel terminals.",
  "homepage": "https://github.com/novadeck-org/novadeck",
  "license": "GPL-3.0-or-later",
  "author": "mzpkdev",
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "concurrently --kill-others-on-fail --names ui,app \"vite --host 127.0.0.1\" \"electron-vite dev\"",
    "build": "vite build && electron-vite build",
    "package": "pnpm --workspace-root exec turbo run build --filter=@novadeck/desktop && electron-builder --dir --publish never",
    "package:linux": "pnpm --workspace-root exec turbo run build --filter=@novadeck/desktop && electron-builder --linux --x64 --publish never",
    "package:mac": "pnpm --workspace-root exec turbo run build --filter=@novadeck/desktop && electron-builder --mac --universal --publish never",
    "package:win": "pnpm --workspace-root exec turbo run build --filter=@novadeck/desktop && electron-builder --win --x64 --publish never",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p renderer/tsconfig.json",
    "smoke": "node scripts/smoke.mjs"
  },
  "dependencies": {
    "electron-updater": "6.8.9",
    "koffi": "3.3.3",
    "node-pty": "catalog:"
  },
  "devDependencies": {
    "@electron/fuses": "1.8.0",
    "@novadeck/build-kit": "workspace:*",
    "@novadeck/core": "workspace:*",
    "@novadeck/log": "workspace:*",
    "@novadeck/protocol": "workspace:*",
    "@novadeck/relay": "workspace:*",
    "@novadeck/runner": "workspace:*",
    "@novadeck/runner-adapter": "workspace:*",
    "@novadeck/runner-client": "workspace:*",
    "@novadeck/ui": "workspace:*",
    "@novadeck/viewers": "workspace:*",
    "@novadeck/wire": "workspace:*",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "concurrently": "^10.0.6",
    "electron": "catalog:",
    "electron-builder": "^26.15.3",
    "electron-vite": "^6.0.0",
    "esbuild": "0.28.2",
    "playwright": "^1.64.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^7.3.7",
    "vitest": "^5.0.5"
  },
  "desktopName": "dev.mzpk.novadeck",
  "productName": "Novadeck"
}
