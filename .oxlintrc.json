                  "@novadeck/ui",
                  "@novadeck/ui/**",
                  "@novadeck/harness-*",
                  "@novadeck/harness-*/**"
                ],
                "message": "A library never imports app code: product specifics come in as options."
              },
              {
                "group": [
                  "**/../atlas",
                  "**/atlas/**",
                  "**/../application",
                  "**/application/**",
                  "**/../harnesses",
                  "**/harnesses/**",
                  "**/../libraries",
                  "**/libraries/**",
                  "**/../*/dist",
                  "**/../*/dist/**"
