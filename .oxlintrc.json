{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "categories": {
    "correctness": "error",
    "perf": "warn",
    "suspicious": "warn"
  },
  "plugins": ["import", "react", "typescript", "unicorn", "vitest"],
  "rules": {
    "func-style": [
      "error",
      "expression",
      {
        "overrides": {
          "namedExports": "expression"
        }
      }
    ],
    "import/no-unassigned-import": "off",
    "prefer-arrow-callback": "error",
    "react/react-in-jsx-scope": "off",
    "typescript/consistent-type-definitions": ["error", "type"],
    "vitest/valid-expect": [
      "error",
      {
        "maxArgs": 2
      }
    ]
  },
  "overrides": [
    {
      "files": ["**/*.test.ts", "**/*.test.tsx", "**/*.spec.ts", "**/*.spec.tsx", "**/*.e2e.ts"],
      "rules": {
        "unicorn/consistent-function-scoping": "off"
      }
    },
    {
      "files": ["**/*.d.ts"],
      "rules": {
        "typescript/consistent-type-definitions": "off"
      }
    },
    {
      "files": ["harnesses/claude/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "@novadeck/runner",
                "message": "An adapter must not depend on the runner."
              }
            ],
            "patterns": [
              {
                "group": ["@novadeck/runner/**"],
                "message": "An adapter must not depend on the runner."
              },
              {
                "group": [
                  "@novadeck/harness-codex",
                  "@novadeck/harness-codex/**",
                  "@novadeck/harness-agy",
                  "@novadeck/harness-agy/**"
                ],
                "message": "An adapter must not import another adapter."
              },
              {
                "group": ["../**", "./../**"],
                "message": "An adapter's sources sit flat in src: nothing above it is its own."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["harnesses/codex/**"],
      "rules": {
        "no-restricted-imports": [
