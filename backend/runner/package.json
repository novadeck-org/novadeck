{
  "name": "@novadeck/runner",
  "version": "0.0.0",
  "private": true,
  "description": "The Novadeck runner: shells and workspace metadata, served over WebSocket or MessagePort.",
  "license": "GPL-3.0-or-later",
  "author": "mzpkdev",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/cli.js",
  "exports": {
    ".": "./src/index.ts",
    "./server": "./src/server.ts",
    "./http": "./src/http.ts"
  },
  "scripts": {
    "dev": "tsx watch --conditions=development src/cli.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/cli.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "@novadeck/emulator": "workspace:*",
    "@novadeck/harness-agy": "workspace:*",
    "@novadeck/harness-claude": "workspace:*",
    "@novadeck/harness-codex": "workspace:*",
    "@novadeck/harness-core": "workspace:*",
    "@novadeck/log": "workspace:*",
    "@novadeck/murmur": "workspace:*",
    "@novadeck/protocol": "workspace:*",
    "@novadeck/relay": "workspace:*",
    "@novadeck/secrets": "workspace:*",
    "@novadeck/terminal": "workspace:*",
    "@novadeck/tui-input": "workspace:*",
    "@novadeck/whisper": "workspace:*",
    "@novadeck/wire": "workspace:*",
    "@orpc/server": "catalog:",
    "hono": "^4.13.14",
    "node-pty": "catalog:",
    "ws": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@novadeck/runner-client": "workspace:*",
    "@novadeck/sandbox": "workspace:*",
    "@types/node": "^26.6.6",
    "@types/ws": "8.18.2",
    "fast-check": "4.10.2",
    "tsx": "^4.20.6",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
