{
  "$schema": "https://turborepo.com/schema.json",
  "extends": ["//"],
  "tasks": {
    "test": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/frontend/ui/**",
        "$TURBO_ROOT$/frontend/*/src/**",
        "$TURBO_ROOT$/libraries/*/src/**/*.css",
        "$TURBO_ROOT$/frontend/*/package.json",
        "$TURBO_ROOT$/libraries/*/package.json",
        "$TURBO_ROOT$/**/.gitignore",
        "$TURBO_ROOT$/pnpm-lock.yaml",
        "!$TURBO_ROOT$/frontend/*/node_modules/**",
        "!$TURBO_ROOT$/frontend/*/.turbo/**",
        "!$TURBO_ROOT$/frontend/**/*.log"
      ]
    }
  }
}
