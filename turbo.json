{
  "$schema": "https://turborepo.com/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "env": [
        "VITE_API_URL",
        "VITE_NOVADECK_RUNNER_URL",
        "VITE_NOVADECK_RUNNER_TOKEN",
        "NOVADECK_RELAY_UNIVERSAL"
      ],
      "passThroughEnv": ["CARGO_HOME", "RUSTUP_HOME"],
      "outputs": ["dist/**", "out/**"]
    },
    "transit": {
      "dependsOn": ["^transit"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "test": {
      "dependsOn": ["^transit"],
      "env": ["VITE_API_URL", "VITE_NOVADECK_RUNNER_URL", "VITE_NOVADECK_RUNNER_TOKEN"],
      "passThroughEnv": [
        "PLAYWRIGHT_BROWSERS_PATH",
        "CI",
        "NOVADECK_UI_TRACE",
        "CARGO_HOME",
        "RUSTUP_HOME"
      ],
      "outputs": []
    },
    "typecheck": {
      "dependsOn": ["^transit"],
      "outputs": []
    }
  }
}
