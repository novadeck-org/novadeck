{
  "name": "@novadeck/harness-pi",
  "version": "0.0.0",
  "private": true,
  "description": "The pi harness adapter: its extension, signals, transcripts, screens and input box.",
  "license": "GPL-3.0-or-later",
  "author": "mzpkdev",
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./bundled": {
      "development": "./src/bundled.ts",
      "types": "./dist/bundled.d.ts",
      "default": "./dist/bundled.js"
    },
    "./box": {
      "development": "./src/box.ts",
      "types": "./dist/box.d.ts",
      "default": "./dist/box.js"
    },
    "./decode": {
      "development": "./src/decode.ts",
      "types": "./dist/decode.d.ts",
      "default": "./dist/decode.js"
    },
    "./dialogs": {
      "development": "./src/dialogs.ts",
      "types": "./dist/dialogs.d.ts",
      "default": "./dist/dialogs.js"
    },
    "./index": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./own-model": {
      "development": "./src/own-model.ts",
      "types": "./dist/own-model.d.ts",
      "default": "./dist/own-model.js"
    },
    "./plugin": {
      "development": "./src/plugin.ts",
      "types": "./dist/plugin.d.ts",
      "default": "./dist/plugin.js"
    },
    "./shapes": {
      "development": "./src/shapes.ts",
      "types": "./dist/shapes.d.ts",
      "default": "./dist/shapes.js"
    },
    "./shim": {
      "development": "./src/shim.ts",
      "types": "./dist/shim.d.ts",
      "default": "./dist/shim.js"
    },
    "./tools": {
      "development": "./src/tools.ts",
      "types": "./dist/tools.d.ts",
      "default": "./dist/tools.js"
    },
    "./transcripts": {
      "development": "./src/transcripts.ts",
      "types": "./dist/transcripts.d.ts",
      "default": "./dist/transcripts.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@novadeck/emulator": "workspace:*",
    "@novadeck/harness-core": "workspace:*",
    "@novadeck/protocol": "workspace:*",
    "@novadeck/tui-input": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "novadeck": {
    "platform": "system"
  }
}
