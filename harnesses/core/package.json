{
  "name": "@novadeck/harness-core",
  "version": "0.0.0",
  "private": true,
  "description": "The contract every agent harness adapter fills in, and the helpers they share: hook reports and commands, events, payload decoding, prompts, dialogs, transcripts and plugin files.",
  "license": "GPL-3.0-or-later",
  "author": "mzpkdev",
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./decode": {
      "development": "./src/decode.ts",
      "types": "./dist/decode.d.ts",
      "default": "./dist/decode.js"
    },
    "./dialogs": {
      "development": "./src/dialogs.ts",
      "types": "./dist/dialogs.d.ts",
      "default": "./dist/dialogs.js"
    },
    "./events": {
      "development": "./src/events.ts",
      "types": "./dist/events.d.ts",
      "default": "./dist/events.js"
    },
    "./fields": {
      "development": "./src/fields.ts",
      "types": "./dist/fields.d.ts",
      "default": "./dist/fields.js"
    },
    "./follow": {
      "development": "./src/follow.ts",
      "types": "./dist/follow.d.ts",
      "default": "./dist/follow.js"
    },
    "./harness": {
      "development": "./src/harness.ts",
      "types": "./dist/harness.d.ts",
      "default": "./dist/harness.js"
    },
    "./header": {
      "development": "./src/header.ts",
      "types": "./dist/header.d.ts",
      "default": "./dist/header.js"
    },
    "./hook-command": {
      "development": "./src/hook-command.ts",
      "types": "./dist/hook-command.d.ts",
      "default": "./dist/hook-command.js"
    },
    "./items": {
      "development": "./src/items.ts",
      "types": "./dist/items.d.ts",
      "default": "./dist/items.js"
    },
    "./plugin": {
      "development": "./src/plugin.ts",
      "types": "./dist/plugin.d.ts",
      "default": "./dist/plugin.js"
    },
    "./prompts": {
      "development": "./src/prompts.ts",
      "types": "./dist/prompts.d.ts",
      "default": "./dist/prompts.js"
    },
    "./report": {
      "development": "./src/report.ts",
      "types": "./dist/report.d.ts",
      "default": "./dist/report.js"
    },
    "./testing/dialogs": {
      "development": "./src/testing/dialogs.ts",
      "types": "./dist/testing/dialogs.d.ts",
      "default": "./dist/testing/dialogs.js"
    },
    "./testing/probes": {
      "development": "./src/testing/probes.ts",
      "types": "./dist/testing/probes.d.ts",
      "default": "./dist/testing/probes.js"
    },
    "./testing/reports": {
      "development": "./src/testing/reports.ts",
      "types": "./dist/testing/reports.d.ts",
      "default": "./dist/testing/reports.js"
    },
    "./testing/screens": {
      "development": "./src/testing/screens.ts",
      "types": "./dist/testing/screens.d.ts",
      "default": "./dist/testing/screens.js"
    },
    "./tools": {
      "development": "./src/tools.ts",
      "types": "./dist/tools.d.ts",
      "default": "./dist/tools.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@novadeck/emulator": "workspace:*",
    "@novadeck/protocol": "workspace:*",
    "@novadeck/tui-input": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
