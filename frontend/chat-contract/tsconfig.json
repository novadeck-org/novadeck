{
  "compilerOptions": {
    // Workspace packages' source, as Vitest reads it: no build first (see docs/build-graph.md).
    // `node` too, which `Bundler` resolution leaves out: the harnesses' source imports
    // Node-only subpaths. The lint keeps the UI's own code off them.
    "customConditions": ["node", "development"],
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    // No .tsx of its own, but its pipeline renders the chat's Transcript, from source.
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["vite/client", "node"]
  },
  "include": ["src/**/*.ts", "vitest.config.ts"]
}
