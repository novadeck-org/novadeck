{
  "name": "@novadeck/items",
  "version": "0.0.0",
  "private": true,
  "description": "The items package: the kinds of item a terminal or a window shows (files, images, pages, plans, changes) and a terminal's messages, their store, bar, taskbar, peek and drag, and the homes that show them.",
  "type": "module",
  "exports": {
    "./actions": "./src/actions.ts",
    "./artifact.css": "./src/artifact.css",
    "./bar": "./src/bar.ts",
    "./drag-session": "./src/drag-session.ts",
    "./mail": "./src/homes/terminal/messages/mail.ts",
    "./mail.css": "./src/homes/terminal/messages/mail.css",
    "./pane.css": "./src/pane.css",
    "./peek.css": "./src/peek.css",
    "./prose.css": "./src/prose.css",
    "./registry": "./src/registry.ts",
    "./state": "./src/state.ts",
    "./syntax.css": "./src/syntax.css",
    "./TabKinds": "./src/homes/terminal/TabKinds.tsx",
    "./taskbar.css": "./src/taskbar.css",
    "./TerminalCompanion": "./src/homes/terminal/TerminalCompanion.tsx",
    "./UndockedWindow": "./src/homes/undocked/UndockedWindow.tsx"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.14",
    "@dnd-kit/dom": "^0.5.1",
    "@dnd-kit/react": "^0.5.1",
    "@novadeck/core": "workspace:*",
    "@novadeck/toolkit": "workspace:*",
    "@novadeck/viewers": "workspace:*",
    "lucide-react": "^1.59.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@novadeck/build-kit": "workspace:*",
    "@novadeck/test-kit": "workspace:*",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "jsdom": "^30.1.3",
    "typescript": "^7.0.2",
    "vite": "^7.3.7",
    "vitest": "^5.0.5"
  }
}
